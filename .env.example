# M1 runs without credentials. M2 needs local Supabase (see docs/MILESTONE_2.md).
# All values are server-only. Never add NEXT_PUBLIC_ to the secret or pepper.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_ORIGIN=http://localhost:3000
INVITE_TOKEN_PEPPER=
# Optional: authenticate the cleanup endpoint when called by a scheduler.
CRON_SECRET=
# Optional lower limits; raising the DB hard caps also requires a migration.
UPLOAD_PHOTO_MAX_BYTES=5242880
UPLOAD_AUDIO_MAX_BYTES=15728640
UPLOAD_AUDIO_MAX_SECONDS=90
